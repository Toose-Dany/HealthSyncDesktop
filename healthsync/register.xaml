<Page x:Class="HealthSync.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="RegisterPage"
      Background="#F5F5F5">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Width="500" Background="White" CornerRadius="10"
                HorizontalAlignment="Center" Margin="50">
            <StackPanel Margin="30">
                <TextBlock Text="Регистрация" FontSize="24" FontWeight="Bold" 
                          Foreground="#1A237E" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Имя пользователя" Margin="0,10,0,5"/>
                <TextBox x:Name="UsernameBox" Padding="10" Background="#F5F5F5"/>

                <TextBlock Text="Email" Margin="0,10,0,5"/>
                <TextBox x:Name="EmailBox" Padding="10" Background="#F5F5F5"/>

                <TextBlock Text="Пароль" Margin="0,10,0,5"/>
                <PasswordBox x:Name="PasswordBox1" Padding="10" Background="#F5F5F5"/>

                <TextBlock Text="Подтверждение пароля" Margin="0,10,0,5"/>
                <PasswordBox x:Name="PasswordBox2" Padding="10" Background="#F5F5F5"/>

                <TextBlock Text="Возраст" Margin="0,10,0,5"/>
                <TextBox x:Name="AgeBox" Padding="10" Background="#F5F5F5"/>

                <TextBlock Text="Пол" Margin="0,10,0,5"/>
                <ComboBox x:Name="GenderBox" Padding="5" Background="#F5F5F5">
                    <ComboBoxItem Content="Мужской"/>
                    <ComboBoxItem Content="Женский"/>
                </ComboBox>

                <TextBlock Text="Рост (см)" Margin="0,10,0,5"/>
                <TextBox x:Name="HeightBox" Padding="10" Background="#F5F5F5"/>

                <TextBlock Text="Вес (кг)" Margin="0,10,0,5"/>
                <TextBox x:Name="WeightBox" Padding="10" Background="#F5F5F5"/>

                <Button x:Name="RegisterButton" Content="Зарегистрироваться" 
                        Background="#1A237E" Foreground="White"
                        Height="40" Margin="0,20" Click="RegisterButton_Click"/>

                <Button x:Name="BackButton" Content="Назад" 
                        Background="Transparent" Foreground="#1A237E"
                        BorderThickness="0" Click="BackButton_Click"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>