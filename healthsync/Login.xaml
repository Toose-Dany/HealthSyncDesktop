<Page x:Class="HealthSync.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="LoginPage"
      Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Width="400" Height="450" 
                Background="White" CornerRadius="10"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Margin="30">
                <TextBlock Text="HealthSync" FontSize="28" FontWeight="Bold" 
                          Foreground="#1A237E" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <TextBlock Text="Вход в аккаунт" FontSize="16" 
                          HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBox x:Name="UsernameTextBox" Margin="0,10" 
                        Padding="10" Background="#F5F5F5"
                        BorderBrush="#E0E0E0" BorderThickness="1"
                        Text="Пользователь"/>

                <PasswordBox x:Name="PasswordBox" Margin="0,10" 
                            Padding="10" Background="#F5F5F5"
                            BorderBrush="#E0E0E0" BorderThickness="1"/>

                <Button x:Name="LoginButton" Content="Войти" 
                        Background="#1A237E" Foreground="White"
                        Height="40" Margin="0,20" Click="LoginButton_Click"/>

                <Button x:Name="RegisterButton" Content="Зарегистрироваться" 
                        Background="Transparent" Foreground="#1A237E"
                        BorderThickness="0" Click="RegisterButton_Click"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="1" Text="© 2026 HealthSync. Все права защищены." 
                   HorizontalAlignment="Center" Margin="10" Foreground="#999"/>
    </Grid>
</Page>