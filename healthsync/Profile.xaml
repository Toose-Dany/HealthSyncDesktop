<Page x:Class="HealthSync.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ProfilePage"
      Background="#F5F5F5">

    <StackPanel Margin="30">
        <Border Background="White" CornerRadius="10" Padding="20">
            <StackPanel>
                <TextBlock Text="👤 Профиль" FontSize="24" FontWeight="Bold" 
                          Foreground="#1A237E" Margin="0,0,0,20"/>

                <TextBlock Text="Имя пользователя:" FontWeight="Bold" Margin="0,10,0,5"/>
                <TextBox x:Name="UsernameBox" Padding="10" Background="#F5F5F5"/>

                <TextBlock Text="Email:" Margin="0,10,0,5"/>
                <TextBox x:Name="EmailBox" Padding="10" Background="#F5F5F5"/>

                <TextBlock Text="Возраст:" Margin="0,10,0,5"/>
                <TextBox x:Name="AgeBox" Padding="10" Background="#F5F5F5"/>

                <TextBlock Text="Рост (см):" Margin="0,10,0,5"/>
                <TextBox x:Name="HeightBox" Padding="10" Background="#F5F5F5"/>

                <TextBlock Text="Вес (кг):" Margin="0,10,0,5"/>
                <TextBox x:Name="WeightBox" Padding="10" Background="#F5F5F5"/>

                <Button x:Name="SaveButton" Content="Сохранить изменения" 
                        Background="#1A237E" Foreground="White"
                        Height="40" Margin="0,20" Click="SaveButton_Click"/>

                <Button x:Name="BackButton" Content="← На главную" 
                        Background="Transparent" Foreground="#1A237E"
                        BorderThickness="0" Click="BackButton_Click"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>