<Page x:Class="HealthSync.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="SettingsPage"
      Background="#F5F5F5">

    <StackPanel Margin="30">
        <Border Background="White" CornerRadius="10" Padding="20">
            <StackPanel>
                <TextBlock Text="⚙️ Настройки" FontSize="24" FontWeight="Bold" 
                          Foreground="#1A237E" Margin="0,0,0,20"/>

                <TextBlock Text="Настройки будут доступны в следующей версии" 
                          Margin="0,20" Foreground="#666"/>

                <Button x:Name="BackButton" Content="← На главную" 
                        Background="#1A237E" Foreground="White"
                        Height="40" Margin="0,20" Click="BackButton_Click"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>