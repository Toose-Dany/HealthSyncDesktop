<Page x:Class="HealthSync.HelpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="HelpPage"
      Background="#F5F5F5">

    <ScrollViewer>
        <Border Width="600" Background="White" CornerRadius="10"
                HorizontalAlignment="Center" Margin="50">
            <StackPanel Margin="30">
                <TextBlock Text="❓ Помощь" FontSize="24" FontWeight="Bold" 
                          Foreground="#1A237E" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Как пользоваться приложением:" FontSize="16" FontWeight="Bold" 
                          Margin="0,0,0,10"/>

                <TextBlock Text="1. Заполните свои личные данные (рост, вес)" Margin="0,5"/>
                <TextBlock Text="2. Установите цели по шагам, воде и сну" Margin="0,5"/>
                <TextBlock Text="3. Добавляйте измерения пульса и давления" Margin="0,5"/>
                <TextBlock Text="4. Записывайте сон каждый день" Margin="0,5"/>
                <TextBlock Text="5. Используйте быстрый ввод для воды и шагов" Margin="0,5"/>

                <Button x:Name="BackButton" Content="← На главную" 
                        Background="#1A237E" Foreground="White"
                        Height="40" Margin="0,20" Click="BackButton_Click"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>