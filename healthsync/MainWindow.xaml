<Window x:Class="HealthSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HealthSync — Дневник здоровья" 
        Height="800" 
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Меню -->
        <Menu Grid.Row="0" Background="#1A237E" Foreground="White">
            <MenuItem Header="Главная" Click="Home_Click"/>
            <MenuItem Header="Профиль" Click="Profile_Click"/>
            <MenuItem Header="Настройки" Click="Settings_Click"/>
            <MenuItem Header="Помощь" Click="Help_Click"/>
            <Separator/>
            <MenuItem Header="Выход" Click="Exit_Click"/>
        </Menu>

        <!-- Основной контент -->
        <Grid Grid.Row="1" x:Name="MainContent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель -->
            <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#1A237E">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="HealthSync" Foreground="White" FontSize="20" FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1" Foreground="#BBDEFB" 
                               VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock.Inlines>
                            <Run Text="Сегодня · "/>
                            <Run x:Name="CurrentDateText" Text=""/>
                        </TextBlock.Inlines>
                    </TextBlock>

                    <!-- SyncCoins с иконкой монеты -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#303F9F" CornerRadius="15" Padding="10,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🪙" FontSize="16" Margin="0,0,5,0"/>
                                <TextBlock x:Name="HeaderSyncCoinText" Text="150" Foreground="White" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ЛЕВАЯ ПАНЕЛЬ: Показатели -->
            <Border Grid.Row="1" Grid.Column="0" Background="White" Margin="10,10,5,10" CornerRadius="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">

                        <!-- ПРОФИЛЬ -->
                        <Border Background="#F5F5F5" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="ЛИЧНЫЕ ДАННЫЕ" FontSize="11" Foreground="#666" Margin="0,0,0,10"/>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Рост -->
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Рост" FontSize="12" Foreground="#666"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="HeightText" Text="178" FontSize="18" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text=" см" FontSize="12" Foreground="#666" 
                                                       VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                                        </Grid>
                                        <Button x:Name="EditHeightButton" Content="✏️" Width="30" Height="25" 
                                                FontSize="12" Margin="0,5,0,0" Click="EditHeight_Click"/>
                                    </StackPanel>

                                    <!-- Вес -->
                                    <StackPanel Grid.Row="0" Grid.Column="1">
                                        <TextBlock Text="Вес" FontSize="12" Foreground="#666"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="WeightText" Text="72.5" FontSize="18" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text=" кг" FontSize="12" Foreground="#666" 
                                                       VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                                        </Grid>
                                        <Button x:Name="EditWeightButton" Content="✏️" Width="30" Height="25" 
                                                FontSize="12" Margin="0,5,0,0" Click="EditWeight_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- ИМТ с анализом -->
                                <Grid Margin="0,15,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ИМТ:" FontSize="14" Foreground="#666" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="BMIText" Text="22.9" FontSize="20" FontWeight="Bold" 
                                               Foreground="#4CAF50" MouseDown="BMIText_MouseDown"
                                               Cursor="Hand" TextDecorations="Underline"/>
                                </Grid>
                                <TextBlock x:Name="BMICategoryText" Text="Нормальный вес ✅" 
                                           FontSize="12" Foreground="#4CAF50"/>
                            </StackPanel>
                        </Border>

                        <!-- СЕРДЦЕ -->
                        <Border Background="#F5F5F5" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="СЕРДЦЕ" FontSize="11" Foreground="#666" Margin="0,0,0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Пульс -->
                                    <StackPanel>
                                        <TextBlock Text="❤️ Пульс" FontSize="12" Foreground="#666"/>
                                        <TextBlock x:Name="HeartRateText" Text="68" FontSize="24" FontWeight="Bold"/>
                                        <TextBlock Text="уд/мин" FontSize="11" Foreground="#666"/>
                                    </StackPanel>

                                    <!-- Давление -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="🫀 Давление" FontSize="12" Foreground="#666"/>
                                        <TextBlock x:Name="BloodPressureText" Text="118/75" FontSize="20" FontWeight="Bold"
                                                   Cursor="Hand" MouseDown="BloodPressureText_MouseDown"/>
                                    </StackPanel>
                                </Grid>

                                <Button x:Name="AddVitalsButton" Content="➕ Добавить измерение" Background="#E8EAF6" 
                                        Foreground="#1A237E" Margin="0,10,0,0" Height="30" Click="AddVitals_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- СОН -->
                        <Border Background="#F5F5F5" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="СОН" FontSize="11" Foreground="#666" Margin="0,0,0,10"/>

                                <StackPanel>
                                    <TextBlock x:Name="SleepHoursText" Text="7.5" FontSize="24" FontWeight="Bold"/>
                                    <TextBlock Text="часов" FontSize="11" Foreground="#666"/>
                                </StackPanel>

                                <Button x:Name="LogSleepButton" Content="😴 Записать сон" Background="#E1F5FE" 
                                        Foreground="#0277BD" Margin="0,10,0,0" Height="30" Click="LogSleep_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ЦЕНТРАЛЬНАЯ ПАНЕЛЬ: Главная -->
            <Border Grid.Row="1" Grid.Column="1" Background="White" Margin="5,10,5,10" CornerRadius="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">

                        <!-- Инсайт дня -->
                        <Border Background="#E8F5E8" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                            <TextBlock x:Name="DailyInsightText" TextWrapping="Wrap"
                                       Text="💡 Ваш пульс в норме. Для здоровья сердца старайтесь проходить 8000+ шагов ежедневно."/>
                        </Border>

                        <!-- Активность за неделю -->
                        <TextBlock Text="Активность за неделю" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                        <Border Background="#FAFAFA" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                            <StackPanel>
                                <!-- Переключатель метрик -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                                    <RadioButton x:Name="StepsRadio" Content="👣 Шаги" GroupName="Metrics" 
                                                 IsChecked="True" Margin="10,0" Foreground="#4CAF50" 
                                                 Checked="MetricRadio_Checked"/>
                                    <RadioButton x:Name="WaterRadio" Content="💧 Вода" GroupName="Metrics" 
                                                 Margin="10,0" Foreground="#2196F3" 
                                                 Checked="MetricRadio_Checked"/>
                                    <RadioButton x:Name="SleepRadio" Content="😴 Сон" GroupName="Metrics" 
                                                 Margin="10,0" Foreground="#5C6BC0" 
                                                 Checked="MetricRadio_Checked"/>
                                    <RadioButton x:Name="CaloriesRadio" Content="🔥 Калории" GroupName="Metrics" 
                                                 Margin="10,0" Foreground="#FF5722" 
                                                 Checked="MetricRadio_Checked"/>
                                </StackPanel>

                                <!-- График -->
                                <Grid Height="150" Margin="0,0,0,5">
                                    <UniformGrid x:Name="MetricsGraphGrid" Columns="7" Rows="1" Height="150">
                                        <Border Background="#4CAF50" Height="60" Width="30" 
                                                VerticalAlignment="Bottom" HorizontalAlignment="Center" CornerRadius="4,4,0,0"/>
                                        <Border Background="#4CAF50" Height="55" Width="30" 
                                                VerticalAlignment="Bottom" HorizontalAlignment="Center" CornerRadius="4,4,0,0"/>
                                        <Border Background="#4CAF50" Height="75" Width="30" 
                                                VerticalAlignment="Bottom" HorizontalAlignment="Center" CornerRadius="4,4,0,0"/>
                                        <Border Background="#4CAF50" Height="70" Width="30" 
                                                VerticalAlignment="Bottom" HorizontalAlignment="Center" CornerRadius="4,4,0,0"/>
                                        <Border Background="#4CAF50" Height="50" Width="30" 
                                                VerticalAlignment="Bottom" HorizontalAlignment="Center" CornerRadius="4,4,0,0"/>
                                        <Border Background="#4CAF50" Height="90" Width="30" 
                                                VerticalAlignment="Bottom" HorizontalAlignment="Center" CornerRadius="4,4,0,0"/>
                                        <Border Background="#4CAF50" Height="85" Width="30" 
                                                VerticalAlignment="Bottom" HorizontalAlignment="Center" CornerRadius="4,4,0,0"/>
                                    </UniformGrid>

                                    <!-- Линия цели -->
                                    <Border x:Name="TargetLine" Height="2" Background="#FFD700" 
                                            HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                                            Margin="0,0,0,0" Visibility="Visible"/>

                                    <!-- Кружок на конце линии -->
                                    <Ellipse x:Name="TargetMarker" Width="10" Height="10" 
                                             Fill="#FFD700" Stroke="White" StrokeThickness="1"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                             Margin="0,0,10,0" Visibility="Visible"/>

                                    <!-- Текст цели -->
                                    <TextBlock x:Name="TargetText" Text="🎯" FontSize="10" FontWeight="Bold"
                                               Foreground="#FFD700" Background="Transparent"
                                               HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                               Margin="0,0,25,0" Visibility="Visible"/>
                                </Grid>

                                <!-- Подписи дней -->
                                <UniformGrid Columns="7" Rows="1" Margin="0,5,0,0">
                                    <TextBlock Text="ПН" HorizontalAlignment="Center" FontSize="10" Foreground="#999"/>
                                    <TextBlock Text="ВТ" HorizontalAlignment="Center" FontSize="10" Foreground="#999"/>
                                    <TextBlock Text="СР" HorizontalAlignment="Center" FontSize="10" Foreground="#999"/>
                                    <TextBlock Text="ЧТ" HorizontalAlignment="Center" FontSize="10" Foreground="#999"/>
                                    <TextBlock Text="ПТ" HorizontalAlignment="Center" FontSize="10" Foreground="#999"/>
                                    <TextBlock Text="СБ" HorizontalAlignment="Center" FontSize="10" Foreground="#999"/>
                                    <TextBlock Text="ВС" HorizontalAlignment="Center" FontSize="10" Foreground="#999"/>
                                </UniformGrid>

                                <!-- Текущее значение -->
                                <TextBlock x:Name="CurrentMetricValue" Text="Шаги: 0" 
                                           HorizontalAlignment="Center" Margin="0,10,0,0" 
                                           FontSize="12" FontWeight="Bold" Foreground="#4CAF50"/>
                            </StackPanel>
                        </Border>

                        <!-- Цели на сегодня -->
                        <TextBlock Text="Цели на сегодня" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                        <!-- Вода -->
                        <Border Background="#F5F5F5" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="💧" FontSize="18" Grid.Column="0"/>
                                <StackPanel Grid.Column="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Вода" FontSize="12" FontWeight="Bold"/>
                                        <TextBlock x:Name="WaterGoalText" Grid.Column="1" Text="0/2.5 л" FontSize="11" Foreground="#666"
                                                   Cursor="Hand" MouseDown="WaterGoalText_MouseDown"/>
                                    </Grid>
                                    <ProgressBar x:Name="WaterProgressBar" Value="0" Height="4" Maximum="100"
                                                 Foreground="#2196F3" Background="#E0E0E0" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button x:Name="AddWaterButton" Grid.Column="2" Content="+250 мл" 
                                        Background="#2196F3" Foreground="White" FontSize="10" 
                                        Height="25" Margin="5,0,5,0" Click="AddWater_Click"/>
                                <Button x:Name="SetWaterButton" Grid.Column="3" Content="✏️" 
                                        Background="#FF9800" Foreground="White" FontSize="10" 
                                        Height="25" Width="30" Margin="0,0,5,0" Click="SetWater_Click"/>
                                <Button x:Name="UndoWaterButton" Grid.Column="4" Content="↩️" 
                                        Background="#9E9E9E" Foreground="White" FontSize="10" 
                                        Height="25" Width="30" Margin="0,0,0,0" Click="UndoWater_Click"/>
                            </Grid>
                        </Border>

                        <!-- Шаги -->
                        <Border Background="#F5F5F5" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="👣" FontSize="18" Grid.Column="0"/>
                                <StackPanel Grid.Column="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Шаги" FontSize="12" FontWeight="Bold"/>
                                        <TextBlock x:Name="StepsGoalText" Grid.Column="1" Text="0/10,000" FontSize="11" Foreground="#666"
                                                   Cursor="Hand" MouseDown="StepsGoalText_MouseDown"/>
                                    </Grid>
                                    <ProgressBar x:Name="StepsProgressBar" Value="0" Height="4" Maximum="100"
                                                 Foreground="#FF9800" Background="#E0E0E0" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button x:Name="AddStepsButton" Grid.Column="2" Content="+500" 
                                        Background="#FF9800" Foreground="White" FontSize="10" 
                                        Height="25" Margin="5,0,5,0" Click="AddSteps_Click"/>
                                <Button x:Name="SetStepsButton" Grid.Column="3" Content="✏️" 
                                        Background="#FF9800" Foreground="White" FontSize="10" 
                                        Height="25" Width="30" Margin="0,0,5,0" Click="SetSteps_Click"/>
                                <Button x:Name="UndoStepsButton" Grid.Column="4" Content="↩️" 
                                        Background="#9E9E9E" Foreground="White" FontSize="10" 
                                        Height="25" Width="30" Margin="0,0,0,0" Click="UndoSteps_Click"/>
                            </Grid>
                        </Border>

                        <!-- Сон -->
                        <Border Background="#F5F5F5" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="😴" FontSize="18" Grid.Column="0"/>
                                <StackPanel Grid.Column="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Сон" FontSize="12" FontWeight="Bold"/>
                                        <TextBlock x:Name="SleepGoalText" Grid.Column="1" Text="0/8 ч" FontSize="11" Foreground="#666"
                                                   Cursor="Hand" MouseDown="SleepGoalText_MouseDown"/>
                                    </Grid>
                                    <ProgressBar x:Name="SleepProgressBar" Value="0" Height="4" Maximum="100"
                                                 Foreground="#5C6BC0" Background="#E0E0E0" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button x:Name="AddSleepButton" Grid.Column="2" Content="+1 ч" 
                                        Background="#5C6BC0" Foreground="White" FontSize="10" 
                                        Height="25" Margin="5,0,5,0" Click="AddSleep_Click"/>
                                <Button x:Name="SetSleepButton" Grid.Column="3" Content="✏️" 
                                        Background="#5C6BC0" Foreground="White" FontSize="10" 
                                        Height="25" Width="30" Margin="0,0,5,0" Click="SetSleep_Click"/>
                                <Button x:Name="UndoSleepButton" Grid.Column="4" Content="↩️" 
                                        Background="#9E9E9E" Foreground="White" FontSize="10" 
                                        Height="25" Width="30" Margin="0,0,0,0" Click="UndoSleep_Click"/>
                            </Grid>
                        </Border>

                        <!-- Калории -->
                        <Border Background="#F5F5F5" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="🔥" FontSize="18" Grid.Column="0"/>
                                <StackPanel Grid.Column="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Калории" FontSize="12" FontWeight="Bold"/>
                                        <TextBlock x:Name="CaloriesGoalText" Grid.Column="1" Text="0/2000" FontSize="11" Foreground="#666"
                                                   Cursor="Hand" MouseDown="CaloriesGoalText_MouseDown"/>
                                    </Grid>
                                    <ProgressBar x:Name="CaloriesProgressBar" Value="0" Height="4" Maximum="100"
                                                 Foreground="#FF5722" Background="#E0E0E0" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button x:Name="AddCaloriesButton" Grid.Column="2" Content="+100" 
                                        Background="#FF5722" Foreground="White" FontSize="10" 
                                        Height="25" Margin="5,0,5,0" Click="AddCalories_Click"/>
                                <Button x:Name="SetCaloriesButton" Grid.Column="3" Content="✏️" 
                                        Background="#FF5722" Foreground="White" FontSize="10" 
                                        Height="25" Width="30" Margin="0,0,5,0" Click="SetCalories_Click"/>
                                <Button x:Name="UndoCaloriesButton" Grid.Column="4" Content="↩️" 
                                        Background="#9E9E9E" Foreground="White" FontSize="10" 
                                        Height="25" Width="30" Margin="0,0,0,0" Click="UndoCalories_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ПРАВАЯ ПАНЕЛЬ: Рекомендации -->
            <Border Grid.Row="1" Grid.Column="2" Background="White" Margin="5,10,10,10" CornerRadius="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">

                        <!-- Прогноз -->
                        <Border Background="#667EEA" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="ПРОГНОЗ" Foreground="#E0E0FF" FontSize="10"/>
                                <TextBlock x:Name="BioAgeText" Text="Биологический возраст: 32" 
                                           Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,5,0,0"/>
                                <TextBlock Text="(фактический: 28)" Foreground="#E0E0FF" FontSize="10"/>
                            </StackPanel>
                        </Border>

                        <!-- Рекомендации -->
                        <TextBlock Text="РЕКОМЕНДАЦИИ" FontSize="11" Foreground="#666" Margin="0,0,0,10"/>

                        <Border Background="#FFF9C4" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🌅" FontSize="20" Grid.Column="0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Прогулка" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock Text="Сейчас отличное время для прогулки" 
                                               FontSize="10" Foreground="#666" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="#E1F5FE" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="💧" FontSize="20" Grid.Column="0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Вода" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock x:Name="WaterRecommendationText" Text="Осталось выпить 2.5 л воды" 
                                               FontSize="10" Foreground="#666" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- История -->
                        <TextBlock Text="ИСТОРИЯ" FontSize="11" Foreground="#666" Margin="0,15,0,10"/>

                        <ListBox x:Name="HistoryListBox" Background="Transparent" BorderThickness="0" Height="250">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F5F5F5" CornerRadius="6" Padding="8" Margin="0,0,0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Icon}" FontSize="16" Grid.Column="0"/>
                                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Time}" FontSize="10" Foreground="#666"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Value}" FontSize="12" FontWeight="Bold" 
                                                       Foreground="{Binding Color}" Grid.Column="2"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Нижняя панель -->
            <Border Grid.Row="2" Grid.ColumnSpan="3" Background="White" Margin="10,0,10,10" 
                    CornerRadius="10" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="👣" FontSize="20" Margin="0,0,5,0"/>
                        <StackPanel>
                            <TextBlock Text="Шаги" FontSize="10" Foreground="#666"/>
